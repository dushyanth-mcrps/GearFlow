# Server Port
PORT=5001

# Environment
NODE_ENV=development

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# MongoDB Connection String (e.g. from MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/gearflow?retryWrites=true&w=majority

# Fallback SQLite DB Path
DB_PATH=./gearflow.sqlite
