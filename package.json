{
  "name": "gearflow",
  "version": "1.0.0",
  "description": "GearFlow - Enterprise & Academic Asset Lending Platform with Custody Lifecycle, Condition Auditing, and Overdue Penalty Engine",
  "scripts": {
    "setup": "npm --prefix server install && npm --prefix client install",
    "seed": "npm --prefix server run seed",
    "seed:mongo": "npm --prefix server run seed:mongo",
    "server": "npm --prefix server start",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build",
    "prod": "npm run build && node server/src/index.js",
    "start": "node server/src/index.js",
    "test": "npm --prefix server test",
    "verify": "node server/test/verifySystem.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
